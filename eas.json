{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_ADS": "production",
        "EXPO_PUBLIC_ANALYTICS": "on"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
