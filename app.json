{
  "expo": {
    "name": "Exame Psicotecnico",
    "slug": "exame-psicotecnico",
    "owner": "rotec",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.rotech.examepsicotecnico",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0E3B43"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9218769381944425~7120876774",
          "iosAppId": "ca-app-pub-9218769381944425~7120876774"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBEF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1F23"
          }
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "52ab2469-1ce8-4cd9-ac11-8fb8e14c9c35"
      }
    },
    "scheme": "examepsicotecnico"
  }
}
